# Solace Society — cache policy (Hostinger / Apache)
# HTML is always revalidated; versioned assets (?v=hash) are cached forever.
# After each deploy, only HTML travels again — assets only when they changed.

<IfModule mod_headers.c>
  # HTML pages: revalidate every visit
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Hashed static assets: immutable, 1 year
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Sitemap & robots: short cache
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# One canonical host — everything else redirects
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.solacesociety\.in$ [NC]
  RewriteRule ^(.*)$ https://solacesociety.in/$1 [L,R=301]

  # Extensionless URLs: /experiences serves experiences.html
  # (redirect the .html variant to the clean URL for one canonical form)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([a-zA-Z0-9_-]+)$ $1.html [L]
  RewriteCond %{THE_REQUEST} \s/([a-zA-Z0-9_-]+)\.html[\s?]
  RewriteRule ^([a-zA-Z0-9_-]+)\.html$ /$1 [L,R=301]
</IfModule>
